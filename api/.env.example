# Kerala Camp Check — API configuration.
# Copy to .env for local development. NEVER commit the real .env.
#
# In production these are set in the Render dashboard, not in a file.

# --- Supabase project -------------------------------------------------------
SUPABASE_URL=https://gkyeujohbbduozggnnvk.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_STORAGE_BUCKET=camp-images

# --- Privileged. Never expose to the browser, never commit. -----------------
# Without these the API still serves reads, and every write returns 503 with a
# clear message rather than failing obscurely.

# Storage (image upload + signed URLs) and admin auth.
SUPABASE_SERVICE_ROLE_KEY=

# Transaction pooler, port 6543 — the runtime connection pool.
SUPABASE_DB_URL=

# Session/direct connection, port 5432 — migrations and the data copy script.
# Not needed by the running service; used by psql and scripts/migrate-data.py.
SUPABASE_DB_URL_DIRECT=

# Peppers the OTP hash so a leaked otp_challenges table is not brute-forceable.
# Any long random string. Changing it invalidates in-flight codes.
OTP_PEPPER=

# --- Service ----------------------------------------------------------------
ENVIRONMENT=development

# Browser origins allowed to call this API. Comma separated, no trailing slash.
# Production example: https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Swap once an Indian DLT sender ID is registered.
SMS_PROVIDER=stub
