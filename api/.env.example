# Public read surface — safe to commit values of this shape.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_STORAGE_BUCKET=camp-images
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Privileged. NEVER commit real values, never expose to the browser.
# Without these the API serves reads and returns 503 for writes/admin.
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DB_URL=postgresql://...:6543/postgres        # transaction pooler
# SUPABASE_DB_URL_DIRECT=postgresql://...:5432/postgres # direct, for DDL
# OTP_PEPPER=<long random string>
